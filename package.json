{
  "name": "kasirku",
  "version": "2.5",
  "description": "Simple & Efficient Point of Sale (PoS) System",
  "author": "KevinAdhaikal",
  "homepage": "https://github.com/kevinadhaikal/kasirku",
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun --watch index.ts",
    "build": "cd frontend && bun install && bun run build",
    "build:all": "cd frontend && bun install && bun run build && cd ../setup-frontend && bun install && bun run build",
    "frontend:dev": "cd frontend && bun run dev",
    "frontend:build": "cd frontend && bun run build",
    "setup:dev": "cd setup-frontend && bun run dev",
    "setup:build": "cd setup-frontend && bun run build",
    "drizzle:generate": "bun run scripts/drizzle/generate.ts"
  },
  "dependencies": {
    "clean-css": "^5.3.3",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.24.2",
    "node-forge": "^1.4.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/clean-css": "^4.2.11",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.23.1",
    "@types/bun": "^1.4.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
